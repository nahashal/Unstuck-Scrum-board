PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/unstuck?retryWrites=true&w=majority
GEMINI_API_KEY=your_gemini_api_key_here
# Comma-separated list; first working model wins
GEMINI_MODEL=gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite
# Long random string used to sign login sessions
JWT_SECRET=change_me_to_a_long_random_string
# Comma-separated emails that are Platform Admins
PLATFORM_ADMIN_EMAILS=
# Base URL used in invite links
FRONTEND_URL=http://localhost:5173
# Invite emails via Brevo (optional; without them, invite links are shared manually)
BREVO_API_KEY=your_brevo_api_key_here
# Must be a sender verified in Brevo (Senders, Domains & Dedicated IPs)
BREVO_SENDER_EMAIL=you@yourdomain.com
BREVO_SENDER_NAME=Unstuck
